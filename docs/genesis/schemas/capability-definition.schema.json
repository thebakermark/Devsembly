{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devsembly.example/schemas/capability-definition/0.1.0",
  "title": "Devsembly Capability Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "status",
    "owner",
    "outcome",
    "operations",
    "security",
    "service",
    "cost",
    "conformance"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "$ref": "#/$defs/semanticVersion"
    },
    "id": {
      "$ref": "#/$defs/stableId"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "$ref": "#/$defs/semanticVersion"
    },
    "status": {
      "enum": [
        "current",
        "planned",
        "proposed",
        "deferred",
        "deprecated"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "mutation",
          "authority",
          "idempotency",
          "timeout_seconds"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/stableId"
          },
          "mutation": {
            "type": "boolean"
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "idempotency": {
            "enum": [
              "not-required",
              "required",
              "reconciliation-required",
              "non-idempotent"
            ]
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "security": {
      "type": "object",
      "required": [
        "data_classifications",
        "least_privilege"
      ],
      "properties": {
        "data_classifications": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "least_privilege": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "required": [
        "health_required",
        "observability_required"
      ],
      "properties": {
        "health_required": {
          "type": "boolean"
        },
        "observability_required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "cost": {
      "type": "object",
      "required": [
        "estimate_required",
        "usage_required"
      ],
      "properties": {
        "estimate_required": {
          "type": "boolean"
        },
        "usage_required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "conformance": {
      "type": "object",
      "required": [
        "suite_version"
      ],
      "properties": {
        "suite_version": {
          "$ref": "#/$defs/semanticVersion"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    }
  }
}
