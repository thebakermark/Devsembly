{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devsembly.local/schemas/task-packet.schema.json",
  "title": "Devsembly Task Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "product",
    "objective",
    "risk",
    "repository",
    "scope",
    "acceptanceCriteria",
    "validation",
    "budgets",
    "dependencies"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "product": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "risk": {"enum": ["low", "medium", "high", "critical"]},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fullName", "baseRef", "workBranch"],
      "properties": {
        "fullName": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "baseRef": {"type": "string", "minLength": 1},
        "workBranch": {"type": "string", "minLength": 1}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedPaths", "forbiddenPaths"],
      "properties": {
        "allowedPaths": {"type": "array", "items": {"type": "string"}},
        "forbiddenPaths": {"type": "array", "items": {"type": "string"}}
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "requiredGates"],
      "properties": {
        "commands": {"type": "array", "items": {"type": "string"}},
        "requiredGates": {
          "type": "array",
          "items": {
            "enum": [
              "format",
              "lint",
              "types",
              "unit",
              "integration",
              "e2e",
              "build",
              "secrets",
              "dependencies",
              "container",
              "policy",
              "migration"
            ]
          }
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxAttempts", "maxTokens", "maxCostUsd", "deadlineMinutes"],
      "properties": {
        "maxAttempts": {"type": "integer", "minimum": 1, "maximum": 10},
        "maxTokens": {"type": "integer", "minimum": 1},
        "maxCostUsd": {"type": "number", "minimum": 0},
        "deadlineMinutes": {"type": "integer", "minimum": 1}
      }
    },
    "dependencies": {
      "type": "array",
      "items": {"type": "string"}
    },
    "requiredArtifacts": {
      "type": "array",
      "items": {
        "enum": [
          "patch",
          "test-results",
          "screenshots",
          "architecture-decision",
          "threat-model",
          "migration-plan",
          "rollback-plan",
          "documentation",
          "release-notes"
        ]
      }
    },
    "approvalPolicy": {
      "enum": ["automatic", "batched-human", "explicit-human"]
    }
  }
}
