POSTGRES_USER=devsembly
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=devsembly
DEVSEMBLY_API_PORT=8000
TEMPORAL_UI_PORT=8088
DEVSEMBLY_OUTBOX_POLL_SECONDS=1
DEVSEMBLY_OUTBOX_HEALTH_MAX_AGE_SECONDS=30
DEVSEMBLY_DISPATCH_POLL_SECONDS=1
DEVSEMBLY_DISPATCH_HEALTH_MAX_AGE_SECONDS=30
DEVSEMBLY_TEMPORAL_TASK_QUEUE=devsembly-factory

MINIO_ROOT_USER=devsembly
MINIO_ROOT_PASSWORD=replace-with-another-long-random-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
DEVSEMBLY_EVIDENCE_BUCKET=devsembly-evidence

# Provider-neutral command that reads a JSON task packet from stdin and edits the workspace.
DEVSEMBLY_CODING_PROVIDER_COMMAND=/app/scripts/providers/claude-code.sh

# Claude Code provider settings. Keep the API key uncommitted.
ANTHROPIC_API_KEY=
DEVSEMBLY_CLAUDE_MODEL=sonnet
DEVSEMBLY_CLAUDE_MAX_TURNS=20

# Token used only by the source-control provider adapter. It is not passed to Claude Code.
DEVSEMBLY_SOURCE_CONTROL_TOKEN=

# Human API authentication. Use the exact OIDC issuer and registered API audience.
DEVSEMBLY_OIDC_ISSUER=
DEVSEMBLY_OIDC_AUDIENCE=

# Separate short-lived credential for the internal workflow-control endpoint.
DEVSEMBLY_INTERNAL_CONTROL_TOKEN=

# GitHub webhook HMAC secret used by the PIE synchronization endpoint.
DEVSEMBLY_GITHUB_WEBHOOK_SECRET=
